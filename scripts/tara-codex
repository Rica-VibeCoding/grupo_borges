#!/usr/bin/env bash
# tara-codex — wrapper de observabilidade pra `codex exec`.
#
# Executa `codex exec --json` e relaya cada linha JSONL pra
# POST /api/codex-events do cockpit. Emite eventos de lifecycle
# (started/completed/failed) antes/depois do exec.
#
# Uso (substitui `nohup codex exec ... &` no workflow do Daniel):
#   tara-codex --delegator daniel -C /home/clawd/repos/grupo_borges "<prompt>"
#
# Args extras (após `--`) passam direto pro `codex exec`.
#
# Contrato de saída (2026-07-19, batismo Hiro→Tara):
#   STDOUT = só a última agent_message (resultado limpo, análogo ao hiro-k3)
#   STDERR = JSONL cru do `codex exec --json` (relay de observabilidade)
#   stdin da chamada interna é fechado (< /dev/null) — sem isso o codex
#   fica em "Reading additional input from stdin..." eternamente quando
#   disparado por outro agente (pipe de stdin aberto no harness).
#   O -C precisa ser repo git (ou usar --skip-git-repo-check) — o codex
#   aborta em pasta avulsa: "Not inside a trusted directory".
#
# Flags lidas pelo wrapper:
#   --delegator <slug>   identifica quem disparou (default: daniel)
#   --cockpit-url <url>  endpoint /api/codex-events
#   --resume-thread <id> retoma explicitamente uma thread Codex (vence
#                        --resume-last)
#   --resume-last        reusa thread_id capturada do último run desse
#                        delegator (se < 12h); senão segue fresh e avisa
#   --fresh              no-op explícito — default é fresh
#
# Defaults:
#   COCKPIT_URL=http://127.0.0.1:8000
#   DELEGATOR=daniel (se -d/--delegator não passado)
#
# Thread store: ~/.tara/threads/<delegator>.txt — gravada quando o evento
# JSONL `thread.started` é observado. Quem decide --resume-last é o
# Daniel-CC ao montar o comando, não o wrapper.
#
# NÃO commitar prompts com segredos — payload passa por scrub no backend
# mas evita expor no log local.

set -euo pipefail

COCKPIT_URL="${COCKPIT_URL:-http://127.0.0.1:8000}"
DELEGATOR="${TARA_DELEGATOR:-daniel}"
CODEX_BIN="${CODEX_BIN:-codex}"
THREAD_DIR="${TARA_THREAD_DIR:-${HOME}/.tara/threads}"
THREAD_MAX_AGE=43200  # 12h em segundos

RESUME_LAST=0
RESUME_THREAD=""
CODEX_ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -d|--delegator)
      DELEGATOR="$2"; shift 2 ;;
    --cockpit-url)
      COCKPIT_URL="$2"; shift 2 ;;
    --resume-thread)
      RESUME_THREAD="$2"; shift 2 ;;
    --resume-last)
      RESUME_LAST=1; shift ;;
    --fresh)
      shift ;;
    --)
      shift; CODEX_ARGS+=("$@"); break ;;
    *)
      CODEX_ARGS+=("$1"); shift ;;
  esac
done

if [[ ${#CODEX_ARGS[@]} -eq 0 ]]; then
  echo "uso: tara-codex [--delegator <slug>] [--resume-last] -- <args do codex exec>" >&2
  echo "ou:  tara-codex [--delegator <slug>] [--resume-last] <args do codex exec>" >&2
  exit 2
fi

# Marca a delegação pra statusline mostrar "Tara trabalhando há Xs" durante a espera.
DELEG_HELPER=/home/clawd/repos/ze_claude/ze-shared/scripts/deleg-estado.sh
if [[ -r "$DELEG_HELPER" ]]; then
  source "$DELEG_HELPER" && deleg_marcar_inicio "Tara" "$DELEGATOR" tara
fi

mkdir -p "$THREAD_DIR"
THREAD_FILE="$THREAD_DIR/${DELEGATOR}.txt"

if [[ -n "$RESUME_THREAD" ]]; then
  echo "[tara-codex] retomando thread $RESUME_THREAD (--resume-thread)" >&2
elif [[ "$RESUME_LAST" -eq 1 ]]; then
  if [[ -f "$THREAD_FILE" ]]; then
    age=$(( $(date +%s) - $(stat -c %Y "$THREAD_FILE") ))
    thread_id=$(<"$THREAD_FILE")
    if [[ -n "$thread_id" && "$age" -lt "$THREAD_MAX_AGE" ]]; then
      RESUME_THREAD="$thread_id"
      echo "[tara-codex] retomando thread $RESUME_THREAD (--resume-last, idade ${age}s)" >&2
    else
      echo "[tara-codex] --resume-last ignorado: thread em $THREAD_FILE tem $((age/3600))h (>12h) ou vazia" >&2
    fi
  else
    echo "[tara-codex] --resume-last ignorado: sem thread anterior em $THREAD_FILE" >&2
  fi
fi

# DS-69 — modelo escolhido pelo Rica no cockpit. Se o chamador NÃO passou
# `-m/--model`, busca o `state_model` persistido da Tara e injeta `-m <raw>`.
# Explícito da linha de comando sempre vence.
#
# O de-para era um `case` com os 8 slugs de DS-69 e `*) echo ""` no fim: modelo
# novo no catálogo caía no vazio, nenhum `-m` era injetado e a Tara rodava o
# default — a troca do Rica sumia sem uma linha de erro. A regra abaixo é
# derivada, não enumerada: no nome canônico o único ponto do nome cru vira
# hífen entre os dois números da versão (`codex-gpt-5-3-codex-spark` →
# `gpt-5.3-codex-spark`). Espelha `services/codex_catalog.py:raw_slug`.
codex_raw_model() {
  local slug="${1#codex-}"
  [[ -z "$slug" ]] && { echo ""; return; }
  # Sem `gpt-<maior>-<menor>` na frente não é slug de modelo Codex: melhor não
  # injetar nada do que injetar um `-m` inventado.
  [[ "$slug" =~ ^gpt-[0-9]+-[0-9]+ ]] || { echo ""; return; }
  sed -E 's/^gpt-([0-9]+)-([0-9]+)/gpt-\1.\2/' <<<"$slug"
}

caller_set_model=0
caller_set_effort=0
caller_set_sandbox=0
for arg in "${CODEX_ARGS[@]}"; do
  case "$arg" in
    -m|--model|-m=*|--model=*) caller_set_model=1; break ;;
  esac
done
for i in "${!CODEX_ARGS[@]}"; do
  arg="${CODEX_ARGS[$i]}"
  next=""
  if [[ "$i" -lt $((${#CODEX_ARGS[@]} - 1)) ]]; then
    next="${CODEX_ARGS[$((i + 1))]}"
  fi
  case "$arg" in
    -c|--config)
      [[ "$next" == model_reasoning_effort=* ]] && caller_set_effort=1
      ;;
    -c=model_reasoning_effort=*|--config=model_reasoning_effort=*|model_reasoning_effort=*)
      caller_set_effort=1
      ;;
    -s|--sandbox|-s=*|--sandbox=*)
      caller_set_sandbox=1
      ;;
  esac
done

persisted_agent_json=$(curl -sS -m 4 "${COCKPIT_URL}/api/agents/tara" 2>/dev/null || true)

if [[ "$caller_set_model" -eq 0 ]]; then
  persisted=$(printf '%s' "$persisted_agent_json" \
    | jq -r '.state_model // empty' 2>/dev/null || true)
  raw=$(codex_raw_model "$persisted")
  if [[ -n "$raw" ]]; then
    CODEX_ARGS=(-m "$raw" "${CODEX_ARGS[@]}")
    echo "[tara-codex] modelo do cockpit: $persisted → -m $raw" >&2
  fi
fi

if [[ "$caller_set_effort" -eq 0 ]]; then
  persisted_effort=$(printf '%s' "$persisted_agent_json" \
    | jq -r '.codex_reasoning_effort // empty' 2>/dev/null || true)
  # A escala parava em `high`: o painel deixava o Rica escolher `xhigh`/`max`,
  # o back gravava, e aqui o pedido era descartado calado. `ultra` entrou junto
  # porque o gpt-5.6-sol/terra o oferecem. Quem recusa nível inválido é o
  # PATCH /effort, contra a escala do modelo — aqui é só repasse.
  if [[ "$persisted_effort" =~ ^(low|medium|high|xhigh|max|ultra)$ ]]; then
    CODEX_ARGS=(-c "model_reasoning_effort=$persisted_effort" "${CODEX_ARGS[@]}")
    echo "[tara-codex] effort do cockpit: model_reasoning_effort=$persisted_effort" >&2
  fi
fi

if [[ "$caller_set_sandbox" -eq 0 ]]; then
  persisted_sandbox=$(printf '%s' "$persisted_agent_json" \
    | jq -r '.codex_sandbox // empty' 2>/dev/null || true)
  case "$persisted_sandbox" in
    read-only|workspace-write|danger-full-access) ;;
    *) persisted_sandbox="danger-full-access" ;;
  esac
  CODEX_ARGS=(-s "$persisted_sandbox" "${CODEX_ARGS[@]}")
  echo "[tara-codex] sandbox do cockpit: -s $persisted_sandbox" >&2
fi

post_event() {
  local kind="$1"
  local body="$2"
  curl -sS -m 4 -X POST "${COCKPIT_URL}/api/codex-events" \
    -H "Content-Type: application/json" \
    -d "$(jq -nc \
      --arg kind "$kind" \
      --arg delegator "$DELEGATOR" \
      --arg body "$body" \
      '{kind: $kind, delegator_agent_slug: $delegator, target_agent_slug: "tara", payload: ($body | fromjson? // {note: $body})}')" \
    > /dev/null || true
}

post_raw_jsonl() {
  local raw="$1"
  local kind
  kind=$(echo "$raw" | jq -r '.type // empty' 2>/dev/null || true)
  if [[ -z "$kind" ]]; then return; fi
  curl -sS -m 4 -X POST "${COCKPIT_URL}/api/codex-events" \
    -H "Content-Type: application/json" \
    -d "$(jq -nc \
      --arg kind "codex.$kind" \
      --arg delegator "$DELEGATOR" \
      --arg raw "$raw" \
      '{kind: $kind, delegator_agent_slug: $delegator, target_agent_slug: "tara", raw_jsonl: $raw, payload: ($raw | fromjson)}')" \
    > /dev/null || true
}

# A régua de escrita do cockpit, que nos CC chega pelo hook UserPromptSubmit
# (`ze-shared/hooks/cockpit-load-skill.sh`). Aqui não vai por hook, e a decisão
# é medida, não preferência: o Codex 0.146 TEM `[[hooks.UserPromptSubmit]]` e o
# `additionalContext` funciona — provei em CODEX_HOME isolado, o modelo devolveu
# a palavra-chave injetada. Só que exige `--dangerously-bypass-hook-trust` em
# toda invocação: sem a flag o hook é pulado EM SILÊNCIO (a doc: "skipped until
# trusted"; sem TUI não há `/hooks` pra aprovar, e em headless nem o aviso sai).
# Pior, o trust é gravado contra o HASH do hook — editar o script desarmaria a
# régua da Tara sem uma linha de erro. Trocar isso por uma flag que a própria
# OpenAI chama de DANGEROUS, e global pra toda sessão dela, sai caro por 10
# linhas de prefixo.
#
# Em TODO turno vindo do cockpit, não só no que nasce a thread. A economia do
# marker por sessão que o hook do CC faz não vale aqui: desde a unificação da
# Tara (terminal + cockpit + Telegram na mesma thread) o cockpit resume uma
# thread que pode ter nascido no terminal — condicionar a "thread nova" faria a
# régua nunca chegar. São ~200 tokens por turno, e determinismo vale mais.
if [[ "$DELEGATOR" == "cockpit" ]]; then
  last_index=$((${#CODEX_ARGS[@]} - 1))
  CODEX_ARGS[$last_index]="Esta mensagem chegou pelo cockpit do grupo_borges — a resposta vai ser LIDA NA TELA pelo Rica, quase sempre no celular. Formate assim:
- Aviso com peso vira alerta do GitHub: \`> [!NOTE]\` \`> [!TIP]\` \`> [!IMPORTANT]\` \`> [!WARNING]\` \`> [!CAUTION]\` — a tela pinta e rotula sozinha. Com parcimônia; abusar tira força.
- Comando pra executar vai em bloco cercado por crase tripla (só ele ganha botão de copiar). Inline é pro que se cita: path, flag, versão, porta.
- Lista pra enumerar. Tabela só em comparação real — no celular ela rola de lado.
- Negrito em palavra-chave, nunca em frase inteira. Header \`##\`/\`###\` quando passar de 5 linhas.
- Pergunta simples = 1 a 3 linhas, sem enfeite. Relatório prolixo é falha de entrega.
Régua completa (ler só se precisar): /home/clawd/repos/ze_claude/ze-shared/.claude/skills/canal-cockpit/SKILL.md

---

${CODEX_ARGS[$last_index]}"
  echo "[tara-codex] régua do cockpit injetada no prompt (delegator=cockpit)" >&2
fi

EXEC_ARGS=(exec --json)
if [[ -n "$RESUME_THREAD" ]]; then
  last_index=$((${#CODEX_ARGS[@]} - 1))
  prompt="${CODEX_ARGS[$last_index]}"
  PRE_RESUME_ARGS=()
  RESUME_IMAGE_ARGS=()
  i=0
  while [[ "$i" -lt "$last_index" ]]; do
    arg="${CODEX_ARGS[$i]}"
    case "$arg" in
      -i|--image)
        if [[ $((i + 1)) -ge "$last_index" ]]; then
          echo "[tara-codex] erro: $arg exige caminho antes do prompt" >&2
          exit 2
        fi
        RESUME_IMAGE_ARGS+=("$arg" "${CODEX_ARGS[$((i + 1))]}")
        i=$((i + 2))
        ;;
      -i=*|--image=*)
        RESUME_IMAGE_ARGS+=("$arg")
        i=$((i + 1))
        ;;
      *)
        PRE_RESUME_ARGS+=("$arg")
        i=$((i + 1))
        ;;
    esac
  done
  if [[ ${#PRE_RESUME_ARGS[@]} -gt 0 ]]; then
    EXEC_ARGS+=("${PRE_RESUME_ARGS[@]}")
  fi
  EXEC_ARGS+=(resume "$RESUME_THREAD")
  if [[ ${#RESUME_IMAGE_ARGS[@]} -gt 0 ]]; then
    EXEC_ARGS+=("${RESUME_IMAGE_ARGS[@]}")
  fi
  EXEC_ARGS+=("$prompt")
else
  EXEC_ARGS+=("${CODEX_ARGS[@]}")
fi

started_at=$(date +%s)
post_event "tara.exec.started" "{\"started_at\":$started_at,\"argv\":$(printf '%s\n' "${EXEC_ARGS[@]}" | jq -R . | jq -sc .)}"

set +e
LAST_MSG_FILE=$(mktemp "${TMPDIR:-/tmp}/tara-codex-lastmsg.XXXXXX")
"$CODEX_BIN" "${EXEC_ARGS[@]}" < /dev/null | while IFS= read -r line; do
  printf '%s\n' "$line" >&2
  # Captura thread_id pra próximo --resume-last.
  if [[ "$line" == *'"thread.started"'* ]]; then
    tid=$(printf '%s' "$line" | jq -r '.thread_id // empty' 2>/dev/null || true)
    if [[ -n "$tid" ]]; then
      printf '%s' "$tid" > "$THREAD_FILE"
    fi
  fi
  # Captura a última agent_message (resultado limpo pro stdout no final).
  if [[ "$line" == *'"item.completed"'* && "$line" == *'"agent_message"'* ]]; then
    printf '%s' "$line" | jq -r '.item.text // empty' > "$LAST_MSG_FILE" 2>/dev/null || true
  fi
  post_raw_jsonl "$line"
done
exit_code=${PIPESTATUS[0]}
set -e

finished_at=$(date +%s)
duration=$((finished_at - started_at))

if [[ "$exit_code" -eq 0 ]]; then
  post_event "tara.exec.completed" "{\"exit_code\":0,\"duration_s\":$duration}"
else
  post_event "tara.exec.failed" "{\"exit_code\":$exit_code,\"duration_s\":$duration}"
fi

# Resultado limpo no stdout (observabilidade JSONL ficou no stderr).
if [[ -s "$LAST_MSG_FILE" ]]; then
  cat "$LAST_MSG_FILE"
  printf '\n'
fi
rm -f "$LAST_MSG_FILE"

exit "$exit_code"
